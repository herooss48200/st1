# ST1 SECRET-ONLY ENVIRONMENT FILE
# Strateji/risk/pozisyon ayarları src/config/agros-policy.js içindedir.
# PAPER modunda Binance anahtarları boş kalabilir. LIVE modunda gerçek anahtarlar yalnız sunucudaki .env dosyasına yazılır.

BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Aktif ST1 stratejisi: 15m kaynaklı Renko + RSI + Bollinger + 0.25T kırılımı.
# Strateji değerlerinin asıl varsayılanları src/config/agros-policy.js içindedir.
ST1_SIMPLE_RENKO_ENTRY_ENABLED=true
ST1_RENKO_SOURCE_INTERVAL=15m
ST1_RENKO_CANDLE_LIMIT=800
ST1_RENKO_MAX_BRICKS=256
ST1_RENKO_ATR_PERIOD=14
ST1_RENKO_BOLLINGER_PERIOD=20
ST1_RENKO_BOLLINGER_STD_DEV=2
ST1_RENKO_BB_TOUCH_TOLERANCE_T=0.25
ST1_RENKO_RSI_PERIOD=14
ST1_RENKO_RSI_OVERSOLD=30
ST1_RENKO_RSI_OVERBOUGHT=70
ST1_RENKO_ENTRY_OFFSET_T=0.25
