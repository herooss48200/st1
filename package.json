{
  "name": "gptsono",
  "version": "1.0.0",
  "description": "Binance Futures USDT-M Professional Trading Platform - BTC Similarity Based Algorithm",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "cross-env NODE_ENV=development node --watch src/index.js",
    "paper": "cross-env APP_MODE=paper ENABLE_REAL_TRADING=false PAPER_UNLIMITED_POSITIONS=true TOP_COINS_COUNT=300 TRADE_SIZE_USDT=50 RISK_PER_TRADE_USDT=0.75 MARKET_BREADTH_NEUTRAL_RISK_USDT=0.40 MARKET_BREADTH_OPPOSED_RISK_USDT=0.25 node src/index.js",
    "testnet": "cross-env APP_MODE=testnet node src/index.js",
    "live": "cross-env APP_MODE=live ENABLE_REAL_TRADING=true PAPER_UNLIMITED_POSITIONS=false node src/index.js",
    "live:preflight": "cross-env APP_MODE=live ENABLE_REAL_TRADING=true PAPER_UNLIMITED_POSITIONS=false node scripts/r41.5-live-preflight.mjs",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --passWithNoTests",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit --passWithNoTests",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/integration",
    "test:system": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/system --passWithNoTests",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --passWithNoTests",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\"",
    "check": "npm run lint && npm run test && npm run build",
    "build": "node --check src/index.js",
    "db:migrate": "node src/database/migrate.js",
    "db:seed": "node src/database/seed.js"
  },
  "keywords": [
    "trading",
    "binance",
    "futures",
    "algorithm",
    "similarity",
    "btc"
  ],
  "author": "GPTSONO Team",
  "license": "PROPRIETARY",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "winston": "^3.11.0",
    "axios": "^1.7.2",
    "ws": "^8.15.0",
    "sqlite3": "^5.1.6",
    "uuid": "^9.0.1",
    "decimal.js": "^10.4.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "eslint": "^8.52.0",
    "prettier": "^3.1.0",
    "supertest": "^6.3.3",
    "@types/jest": "^29.5.8",
    "cross-env": "^7.0.3",
    "node-mocks-http": "^1.13.0"
  }
}
